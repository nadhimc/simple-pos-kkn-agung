# Salin file ini menjadi `.env`, lalu isi juga di Vercel > Settings > Environment Variables.
#
# Nilai di bawah adalah konfigurasi Firebase Web yang memang bersifat publik:
# identifier ini ikut ter-bundle ke JavaScript browser pada aplikasi Firebase
# mana pun. Yang mengamankan data adalah Firebase Auth plus Firestore Security
# Rules (lihat firestore.rules), bukan kerahasiaan nilai-nilai ini.

VITE_FIREBASE_API_KEY=AIzaSyDytgOTaqNH-QdrMdT-mDpaxwVU77SjtAA
VITE_FIREBASE_AUTH_DOMAIN=simple-pos-kkn-agung.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=simple-pos-kkn-agung
VITE_FIREBASE_STORAGE_BUCKET=simple-pos-kkn-agung.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=668925770046
VITE_FIREBASE_APP_ID=1:668925770046:web:846fcef7d0f9e17f7fd46f

# Nama LAYANAN, yang tampil di halaman masuk dan layar tunggu. Nama warung yang
# muncul di sidebar dan tercetak di struk datang dari dokumen tenant-nya, karena
# satu pemasangan aplikasi ini melayani banyak warung.
VITE_STORE_NAME=Warungku
