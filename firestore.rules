rules_version = '2';

// Konfigurasi Firebase Web ikut ter-bundle ke browser, jadi berkas inilah satu
// satunya lapisan yang benar benar menjaga data. Jangan pernah mengembalikan
// aturan ini ke mode terbuka.
//
// Terapkan dengan: firebase deploy --only firestore:rules
// atau tempel isinya di Firebase Console > Firestore Database > Rules.

service cloud.firestore {
  match /databases/{database}/documents {

    /* ------------------------------------------------------------ gerbang */

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isRegistered() {
      return request.auth != null && exists(userPath());
    }

    function me() {
      return get(userPath()).data;
    }

    // Akses dicabut dengan mematikan akunnya, bukan menghapusnya, supaya nama
    // yang tersimpan di struk lama tetap punya rujukan.
    function isActive() {
      return isRegistered() && me().active == true;
    }

    // ADMIN PLATFORM.
    //
    // Mengelola warung dan pengguna, dan sengaja TIDAK diberi akses ke
    // pembukuan warung mana pun. Perhatikan bahwa isAdmin() tidak muncul sama
    // sekali pada aturan subkoleksi tenant di bawah, dan itu disengaja: satu
    // akun admin yang bocor tidak boleh berarti seluruh pembukuan semua warung
    // ikut terbuka.
    function isAdmin() {
      return isActive() && me().role == 'admin';
    }

    // ORANG WARUNG.
    //
    // Satu akun terikat pada tepat satu tenant. `tenantId`-nya dibaca dari
    // dokumen penggunanya di sisi server, bukan dari apa pun yang dikirim
    // browser, jadi tidak ada cara memalsukannya.
    function belongsTo(tenantId) {
      return isActive() && me().tenantId == tenantId;
    }

    // Unit usaha yang dinonaktifkan tidak bisa dibuka siapa pun, tapi datanya
    // tetap utuh. Dokumen lama tanpa field ini dibaca sebagai aktif, jadi tidak
    // ada migrasi yang perlu dijalankan.
    function tenantActive(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)).data.active != false;
    }

    function isMemberOf(tenantId) {
      return belongsTo(tenantId) && tenantActive(tenantId);
    }

    function isPositiveNumber(value) {
      return value is number && value >= 0;
    }

    /* ----------------------------------------------------------- pengguna */

    // Peran menentukan bentuk barisnya, dan keduanya diperiksa bersama supaya
    // tidak ada baris setengah jadi: orang warung WAJIB terikat satu warung,
    // admin platform WAJIB tidak punya warung sama sekali.
    //
    // Admin boleh mengangkat admin baru dari aplikasi, tapi hanya admin. Yang
    // dijaga di sini tetap sama seperti sebelumnya: tidak ada jalan bagi orang
    // yang belum terdaftar untuk memberi dirinya peran apa pun, karena seluruh
    // tulisan ke koleksi ini menuntut isAdmin() lebih dulu.
    function isValidUser() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.tenantId is string
        && request.resource.data.active is bool
        && (
          (
            (request.resource.data.role == 'pemilik' || request.resource.data.role == 'kasir')
            && request.resource.data.tenantId.size() > 0
          )
          || (request.resource.data.role == 'admin' && request.resource.data.tenantId == '')
        );
    }

    // Admin tidak boleh menurunkan peran atau menonaktifkan dirinya sendiri.
    // Platform bisa kehilangan admin terakhirnya, dan tidak ada cara
    // memulihkannya dari dalam aplikasi. Field lain seperti nama tetap boleh
    // diubah sendiri.
    function keepsOwnStanding(uid) {
      return request.auth.uid != uid
        || (
          request.resource.data.role == resource.data.role
          && request.resource.data.active == resource.data.active
        );
    }

    match /users/{uid} {
      // Membaca baris sendiri sengaja terbuka bagi siapa pun yang sudah login,
      // dan itu memang harus. Orang yang belum terdaftar perlu mendapat jawaban
      // "tidak ada" supaya bisa ditolak dengan pesan yang benar. Kalau
      // permintaannya ditolak aturan, AuthContext membacanya sebagai gangguan
      // jaringan lalu gagal terbuka, dan orang asing justru ikut masuk.
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());

      // Tidak ada pendaftaran mandiri. Seluruh pengguna didaftarkan admin.
      allow create: if isAdmin() && isValidUser();
      allow update: if isAdmin() && isValidUser() && keepsOwnStanding(uid);

      // Admin tidak boleh menghapus barisnya sendiri: platform bisa kehilangan
      // admin terakhirnya, dan tidak ada cara memulihkannya dari dalam aplikasi.
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    /* ---------------------------------------------------------- ringkasan */

    // RINGKASAN PER UNIT USAHA.
    //
    // Ada karena admin sengaja tidak diberi akses ke subkoleksi unit usaha mana
    // pun, sehingga ia tidak bisa menjumlahkan struk sendiri. Unit usahanya yang
    // menambahkan angkanya, dalam batch yang sama dengan transaksinya, dan admin
    // hanya membaca.
    //
    // Isinya tidak divalidasi bentuknya, dan itu keputusan sadar: angka di sini
    // persis sepercaya data yang mendasarinya, tidak lebih. Unit usaha sudah
    // memegang penuh catatan penjualannya sendiri, jadi ini tidak menuntut
    // kepercayaan baru. Yang penting dijaga adalah tidak ada unit usaha yang
    // bisa menulis ringkasan milik unit usaha lain.
    match /tenantStats/{tenantId} {
      allow read: if belongsTo(tenantId) || isAdmin();
      allow write: if isMemberOf(tenantId);
    }

    /* ------------------------------------------------------------- warung */

    match /tenants/{tenantId} {
      // Membaca dokumen unit usahanya sendiri sengaja TIDAK ikut memeriksa
      // status aktif. Kalau ikut, orang dari unit usaha yang baru dinonaktifkan
      // akan mendapat permission-denied dan aplikasi membacanya sebagai
      // gangguan jaringan, bukan sebagai "unit usaha ini sedang ditutup". Yang
      // dijaga status aktif adalah datanya, di subkoleksi bawah.
      allow read: if belongsTo(tenantId) || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow delete: if isAdmin();

      // SEKAT ANTAR WARUNG.
      //
      // Tenant adalah bagian dari JALUR dokumen, bukan sekadar field di
      // dalamnya. Karena itu kueri yang lupa memfilter tenant tidak mungkin
      // ada: jalurnya sendiri yang menentukan warung mana yang dibaca, dan
      // isMemberOf() memeriksanya di server pada setiap permintaan.
      //
      // Kalau tenant hanya berupa field, keamanan seluruh layanan bergantung
      // pada setiap kueri di seluruh kode ingat menyertakan filternya. Satu
      // yang lupa, dan omzet warung tetangga ikut terbaca.

      match /products/{productId} {
        allow read: if isMemberOf(tenantId);
        allow create, update: if isMemberOf(tenantId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && isPositiveNumber(request.resource.data.costPrice)
          && isPositiveNumber(request.resource.data.sellPrice)
          && isPositiveNumber(request.resource.data.stock);
        allow delete: if isMemberOf(tenantId);
      }

      // Penjualan. Dokumen tidak boleh diubah setelah dibuat supaya laba
      // historis tidak bisa dikoreksi diam diam. Pembatalan dilakukan dengan
      // menghapus dokumen sekaligus mengembalikan stok, bukan dengan mengedit
      // angkanya.
      match /sales/{saleId} {
        allow read: if isMemberOf(tenantId);
        allow create: if isMemberOf(tenantId)
          && request.resource.data.cashierId == request.auth.uid
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          && isPositiveNumber(request.resource.data.total)
          && isPositiveNumber(request.resource.data.totalCost);
        allow update: if false;
        allow delete: if isMemberOf(tenantId);
      }

      // Resep. Tidak menyimpan harga sama sekali: HPP selalu dihitung ulang
      // dari harga bahan terkini, jadi resep hanya berisi daftar bahan dan
      // takarannya.
      match /recipes/{recipeId} {
        allow read: if isMemberOf(tenantId);
        allow create, update: if isMemberOf(tenantId)
          && request.resource.data.productId is string
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          && request.resource.data.yieldQty is number
          && request.resource.data.yieldQty > 0;
        allow delete: if isMemberOf(tenantId);
      }

      // Produksi. Seperti penjualan, dokumennya tidak boleh diedit supaya HPP
      // historis tidak bisa diubah diam diam.
      match /productions/{productionId} {
        allow read: if isMemberOf(tenantId);
        allow create: if isMemberOf(tenantId)
          && request.resource.data.operatorId == request.auth.uid
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          && isPositiveNumber(request.resource.data.materialCost)
          && request.resource.data.yieldQty is number
          && request.resource.data.yieldQty > 0;
        allow update: if false;
        allow delete: if isMemberOf(tenantId);
      }

      match /expenses/{expenseId} {
        allow read: if isMemberOf(tenantId);
        allow create, update: if isMemberOf(tenantId)
          && request.resource.data.description is string
          && isPositiveNumber(request.resource.data.amount);
        allow delete: if isMemberOf(tenantId);
      }

      // Subkoleksi lain di bawah tenant tidak diberi aturan, jadi ditolak.
    }

    // Koleksi lain di akar, termasuk `staff` dan koleksi datar versi lama,
    // tidak diberi aturan sehingga otomatis ditolak Firestore.
  }
}
