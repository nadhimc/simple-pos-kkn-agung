rules_version = '2';

// Konfigurasi Firebase Web ikut ter-bundle ke browser, jadi berkas inilah satu
// satunya lapisan yang benar benar menjaga data. Jangan pernah mengembalikan
// aturan ini ke mode terbuka.
//
// Terapkan dengan: firebase deploy --only firestore:rules
// atau tempel isinya di Firebase Console > Firestore Database > Rules.

service cloud.firestore {
  match /databases/{database}/documents {

    // GERBANG AKSES.
    //
    // Sejak Google Sign-In aktif, "sudah login" tidak lagi berarti "orang toko":
    // siapa pun pemilik akun Google bisa lolos tahap autentikasi. Yang
    // membedakan adalah keberadaan dokumen staff/{uid}.
    //
    // Dokumen staf hanya dibuat lewat Firebase Console, tidak pernah oleh
    // aplikasi, supaya tidak ada jalan untuk mendaftarkan diri sendiri.
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function isPositiveNumber(value) {
      return value is number && value >= 0;
    }

    // Daftar staf. Setiap orang hanya boleh membaca barisnya sendiri, dan tidak
    // ada seorang pun yang boleh menulis dari aplikasi.
    match /staff/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Produk dan stok.
    match /products/{productId} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && isPositiveNumber(request.resource.data.costPrice)
        && isPositiveNumber(request.resource.data.sellPrice)
        && isPositiveNumber(request.resource.data.stock);
      allow delete: if isStaff();
    }

    // Penjualan. Dokumen tidak boleh diubah setelah dibuat supaya laba historis
    // tidak bisa dikoreksi diam diam. Pembatalan dilakukan dengan menghapus
    // dokumen sekaligus mengembalikan stok, bukan dengan mengedit angkanya.
    match /sales/{saleId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.cashierId == request.auth.uid
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && isPositiveNumber(request.resource.data.total)
        && isPositiveNumber(request.resource.data.totalCost);
      allow update: if false;
      allow delete: if isStaff();
    }

    // Resep. Tidak menyimpan harga sama sekali: HPP selalu dihitung ulang dari
    // harga bahan terkini, jadi resep hanya berisi daftar bahan dan takarannya.
    match /recipes/{recipeId} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.productId is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.yieldQty is number
        && request.resource.data.yieldQty > 0;
      allow delete: if isStaff();
    }

    // Produksi. Seperti penjualan, dokumennya tidak boleh diedit supaya HPP
    // historis tidak bisa diubah diam diam. Koreksi dilakukan dengan
    // membatalkan produksi, yang mengembalikan stok bahan sekaligus.
    match /productions/{productionId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.operatorId == request.auth.uid
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && isPositiveNumber(request.resource.data.materialCost)
        && request.resource.data.yieldQty is number
        && request.resource.data.yieldQty > 0;
      allow update: if false;
      allow delete: if isStaff();
    }

    // Beban operasional.
    match /expenses/{expenseId} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.description is string
        && isPositiveNumber(request.resource.data.amount);
      allow delete: if isStaff();
    }

    // Koleksi lain tidak diberi aturan, sehingga otomatis ditolak Firestore.
  }
}
